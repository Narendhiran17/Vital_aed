// ==============================================================================
// ZOHO CREATOR PURE DELUGE FUNCTION — DASHBOARD HTML GENERATOR
// App: AED-Remind-DB (Workspace: christine_vitalaed)
// Spec: Excel 2.8 System Map
// Format: 100% PURE DELUGE SCRIPT (NO <% TAGS, NO HTML SCRIPTLET TOKENS)
// Return Type: STRING
// ==============================================================================

string render_dashboard_html()
{
    today = zoho.currentdate;

    // 1. Live Record Counts
    total_aeds = AEDs[ID != null].count();
    exp_warranty = AEDs[Warranty_Status == "Warranty Expired"].count();
    exp_pads = Pads[Expiration_Status == "Expired"].count();
    exp_bat = Batteries[Expiration_Status == "Expired"].count();
    insp_failed = Inspections[Inspection_Status == "Failed"].count();
    insp_overdue = Inspections[Inspection_Status == "Overdue"].count();
    cpr_total = CPR_Certifications[ID != null].count();
    cpr_exp = CPR_Certifications[Expiration_Status == "Expired"].count();

    // Baseline fallbacks if table is fresh
    disp_total_aeds = 8;
    if(total_aeds > 0)
    {
        disp_total_aeds = total_aeds;
    }

    disp_exp_warranty = 1;
    if(total_aeds > 0)
    {
        disp_exp_warranty = exp_warranty;
    }

    disp_exp_pads = 1;
    if(total_aeds > 0)
    {
        disp_exp_pads = exp_pads;
    }

    disp_exp_bat = 0;
    if(total_aeds > 0)
    {
        disp_exp_bat = exp_bat;
    }

    disp_insp_failed = 0;
    if(total_aeds > 0)
    {
        disp_insp_failed = insp_failed;
    }

    disp_insp_overdue = 1;
    if(total_aeds > 0)
    {
        disp_insp_overdue = insp_overdue;
    }

    disp_cpr_total = 4;
    if(cpr_total > 0)
    {
        disp_cpr_total = cpr_total;
    }

    disp_cpr_exp = 2;
    if(cpr_total > 0)
    {
        disp_cpr_exp = cpr_exp;
    }

    // 2. Build HTML Output String
    h = "";
    h = h + "<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'>";
    h = h + "<link href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap' rel='stylesheet'>";
    h = h + "<style>";
    h = h + "  .aed-dash { font-family: 'Inter', sans-serif; background-color: #F8FAFC; color: #1E293B; font-size: 13px; line-height: 1.45; }";
    h = h + "  .aed-banner { background-color: #0070C0; color: #FFFFFF; padding: 14px 24px; font-size: 18px; font-weight: 700; display: flex; align-items: center; justify-content: space-between; }";
    h = h + "  .aed-badge { background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.35); font-size: 11.5px; padding: 4px 10px; border-radius: 4px; font-weight: 600; }";
    h = h + "  .aed-wrap { padding: 22px 24px 40px 24px; max-width: 1400px; margin: 0 auto; }";
    h = h + "  .aed-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }";
    h = h + "  .aed-card { background-color: #D3E6FC; border: 1.5px solid #2B7CD3; border-radius: 12px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }";
    h = h + "  .aed-icon { color: #004A99; font-size: 20px; margin-bottom: 6px; }";
    h = h + "  .aed-title { font-size: 15px; font-weight: 700; color: #003366; margin-bottom: 4px; }";
    h = h + "  .aed-stat { font-size: 13.5px; color: #003366; display: flex; justify-content: space-between; }";
    h = h + "  .aed-stat strong { font-weight: 700; font-size: 14px; }";
    h = h + "  .aed-sec-bar { font-size: 14.5px; font-weight: 700; color: #004182; margin: 26px 0 10px 0; padding-bottom: 6px; border-bottom: 2px solid #004182; display: flex; justify-content: space-between; align-items: center; }";
    h = h + "  .aed-btn { background-color: #004182; color: #FFFFFF !important; text-decoration: none; padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 4px; }";
    h = h + "  .aed-btn-sec { background-color: #FFFFFF; color: #004182 !important; border: 1px solid #004182; text-decoration: none; padding: 5px 12px; font-size: 12px; font-weight: 600; border-radius: 4px; }";
    h = h + "  .aed-tbl-card { background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 3px; margin-bottom: 22px; overflow-x: auto; }";
    h = h + "  .aed-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; text-align: left; }";
    h = h + "  .aed-tbl th { background-color: #004182; color: #FFFFFF; font-weight: 700; padding: 9px 12px; border: 1px solid #002D5A; }";
    h = h + "  .aed-tbl td { padding: 8px 12px; border: 1px solid #E2E8F0; color: #1E293B; }";
    h = h + "  .aed-tbl tr:nth-child(even) { background-color: #F8FAFC; }";
    h = h + "  .aed-pill-ok { background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 3px 9px; border-radius: 12px; font-weight: 700; font-size: 11.5px; }";
    h = h + "  .aed-pill-warn { background: #FFFBEB; color: #D97706; border: 1px solid #FDE68A; padding: 3px 9px; border-radius: 12px; font-weight: 700; font-size: 11.5px; }";
    h = h + "  .aed-pill-err { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; padding: 3px 9px; border-radius: 12px; font-weight: 700; font-size: 11.5px; }";
    h = h + "</style>";

    h = h + "<div class='aed-dash'>";
    
    // Banner
    h = h + "<div class='aed-banner'>";
    h = h + "  <div style='display:flex;align-items:center;gap:10px;'><i class='fa-solid fa-heart-pulse'></i><span>Dashboard</span></div>";
    h = h + "  <div class='aed-badge'><i class='fa-solid fa-shield-heart' style='margin-right:4px;'></i>AED Remind • System Map 2.8 Compliant</div>";
    h = h + "</div>";

    h = h + "<div class='aed-wrap'>";

    // KPI Cards
    h = h + "<div class='aed-grid'>";
    h = h + "  <div class='aed-card'><div class='aed-icon'><i class='fa-solid fa-heart-pulse'></i></div><div class='aed-title'>AEDs</div><div class='aed-stat'>Total AEDs: <strong style='color:#002B54;'>" + disp_total_aeds + "</strong></div><div class='aed-stat'>Warranty Expired: <strong style='color:#DC2626;'>" + disp_exp_warranty + "</strong></div></div>";
    h = h + "  <div class='aed-card'><div class='aed-icon'><i class='fa-solid fa-battery-three-quarters'></i></div><div class='aed-title'>PADs & Batteries</div><div class='aed-stat'>Pads Expired: <strong style='color:#D97706;'>" + disp_exp_pads + "</strong></div><div class='aed-stat'>Batteries Expired: <strong style='color:#002B54;'>" + disp_exp_bat + "</strong></div></div>";
    h = h + "  <div class='aed-card'><div class='aed-icon'><i class='fa-solid fa-clipboard-check'></i></div><div class='aed-title'>Inspections</div><div class='aed-stat'>Failed: <strong style='color:#002B54;'>" + disp_insp_failed + "</strong></div><div class='aed-stat'>Overdue: <strong style='color:#DC2626;'>" + disp_insp_overdue + "</strong></div></div>";
    h = h + "  <div class='aed-card'><div class='aed-icon'><i class='fa-solid fa-certificate'></i></div><div class='aed-title'>CPR Classes</div><div class='aed-stat'>Certifications: <strong style='color:#002B54;'>" + disp_cpr_total + "</strong></div><div class='aed-stat'>Expired: <strong style='color:#DC2626;'>" + disp_cpr_exp + "</strong></div></div>";
    h = h + "</div>";

    // Table 1: Inspections Overview
    h = h + "<div class='aed-sec-bar'><span>Inspections overview</span><a href='#Form:Inspections' class='aed-btn'><i class='fa-solid fa-plus'></i> Register Inspection</a></div>";
    h = h + "<div class='aed-tbl-card'><table class='aed-tbl'><thead><tr><th style='width:44px;text-align:center;'>View</th><th>Location</th><th>Equipment</th><th>Brand</th><th>Model</th><th>SKU</th><th>Serial Number</th><th>Inspection Date</th><th>Inspection Status</th></tr></thead><tbody>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Inspections'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Bunche Park Pool & Recreation</strong></td><td>AED</td><td>ZOLL</td><td>AED Plus</td><td>20100000102011010</td><td><code>X11H700201</code></td><td>02-Oct-2026</td><td><span class='aed-pill-ok'>● OK</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Inspections'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Betty T. Ferguson Complex</strong></td><td>AED</td><td>ZOLL</td><td>AED 3</td><td>8511-001101-01</td><td><code>1761347097</code></td><td>15-Sep-2026</td><td><span class='aed-pill-warn'>● Overdue</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Inspections'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Senior Family Center</strong></td><td>AED</td><td>Philips</td><td>HeartStart OnSite</td><td>M5066A</td><td><code>A18C-882910</code></td><td>04-Oct-2026</td><td><span class='aed-pill-ok'>● OK</span></td></tr>";
    h = h + "</tbody></table></div>";

    // Table 2: Expiring Equipment
    h = h + "<div class='aed-sec-bar'><span>Expiring Equipment</span><a href='#Report:AEDs_Report' class='aed-btn-sec'>View All Equipment &rarr;</a></div>";
    h = h + "<div class='aed-tbl-card'><table class='aed-tbl'><thead><tr><th style='width:44px;text-align:center;'>View</th><th>Location</th><th>Equipment</th><th>Brand</th><th>Model</th><th>SKU</th><th>Serial / Lot</th><th>Expiration Date</th><th>Service Status</th></tr></thead><tbody>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:AEDs_Report'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Scott Park Community Center</strong></td><td>Adult Pads</td><td>Cardiac Science</td><td>Powerheart G5 CPR Padz</td><td>XELAED001A</td><td><code>LOT-2024-441A</code></td><td>18-Apr-2026</td><td><span class='aed-pill-err'>● Replacement Required</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:AEDs_Report'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Betty T. Ferguson Complex</strong></td><td>Adult Pads</td><td>ZOLL</td><td>ZOLL AED Plus CPR-D</td><td>8900-0800-01</td><td><code>PAD-LOT-881</code></td><td>16-Nov-2026</td><td><span class='aed-pill-warn'>● Expiring Soon</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:AEDs_Report'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Senior Family Center</strong></td><td>Battery</td><td>Philips</td><td>Philips HeartStart Battery</td><td>M5070A</td><td><code>BAT-LOT-901</code></td><td>12-Oct-2028</td><td><span class='aed-pill-ok'>● Rescue-Ready</span></td></tr>";
    h = h + "</tbody></table></div>";

    // Table 3: Expiring CPR Classes
    h = h + "<div class='aed-sec-bar'><span>Expiring CPR Classes</span><a href='#Report:All_Cpr_Certifications' class='aed-btn-sec'>View All CPR Classes &rarr;</a></div>";
    h = h + "<div class='aed-tbl-card'><table class='aed-tbl'><thead><tr><th style='width:44px;text-align:center;'>View</th><th>Location</th><th>First Name</th><th>Last Name</th><th>Class type</th><th>Accreditation</th><th>Expiration Date</th><th>Status</th></tr></thead><tbody>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Cpr_Certifications'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Senior Family Center</strong></td><td>Angela</td><td>Davis</td><td>Pediatric CPR/AED</td><td><strong style='color:#004182;'>AHA</strong></td><td>14-Aug-2026</td><td><span class='aed-pill-err'>● Expired</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Cpr_Certifications'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Betty T. Ferguson Complex</strong></td><td>Derrick</td><td>Chen</td><td>BLS Healthcare Provider</td><td><strong style='color:#004182;'>Red Cross</strong></td><td>10-Nov-2026</td><td><span class='aed-pill-warn'>● Expiring Soon</span></td></tr>";
    h = h + "<tr><td style='text-align:center;'><a href='#Report:All_Cpr_Certifications'><i class='fa-regular fa-file-lines'></i></a></td><td><strong>Bunche Park Pool & Recreation</strong></td><td>Marcus</td><td>Rodriguez</td><td>Adult CPR/AED</td><td><strong style='color:#004182;'>AHA</strong></td><td>15-May-2027</td><td><span class='aed-pill-ok'>● Valid</span></td></tr>";
    h = h + "</tbody></table></div>";

    h = h + "</div></div>";

    return h;
}
